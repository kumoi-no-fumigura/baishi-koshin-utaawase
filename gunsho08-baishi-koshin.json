 "poems": [
  {
   "seq": "1",
   "text": "曇りなく梢にうつる月かけの花の盛をみるこゝちする",
   "kana": "",
   "speaker": "",
   "page": 476,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "2",
   "text": "みても猶おほつかなきは春のよの霞をわけて出る月影",
   "kana": "",
   "speaker": "",
   "page": 476,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "3",
   "text": "春のよの月に浮るゝたましひはいる山のはにおくれやはする",
   "kana": "",
   "speaker": "",
   "page": 476,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "4",
   "text": "君が代の久しかるへきしめの内はのとかに月の影もすみけり",
   "kana": "",
   "speaker": "",
   "page": 476,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "5",
   "text": "かきつらねかへる雁かね霞わけ花の都のはなをみすてゝ",
   "kana": "",
   "speaker": "",
   "page": 476,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "6",
   "text": "霞たち立かへりゆく雁かねは花に心をとめぬなるへし",
   "kana": "",
   "speaker": "",
   "page": 476,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "7",
   "text": "いつこをかすみかとは思ふ年ことにゆきてはかへる通かり金",
   "kana": "",
   "speaker": "",
   "page": 476,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "8",
   "text": "霧わけておのかとこよはたちしかと霞のまよりかへる雁かね",
   "kana": "",
   "speaker": "",
   "page": 476,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "9",
   "text": "山吹の花や咲らむひまもなくかみなみかはに蛙なくなり",
   "kana": "",
   "speaker": "",
   "page": 476,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "10",
   "text": "春のよはねられさりけりおとろかす蛙の聲にめのみさめつゝ",
   "kana": "",
   "speaker": "",
   "page": 476,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "11",
   "text": "今よりは井てのわたりに家ゐせし蛙の聲に夢のさめけり",
   "kana": "",
   "speaker": "",
   "page": 476,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "12",
   "text": "歸るへきみちもわすれて蛙なく井てにもやかてすむ心哉",
   "kana": "",
   "speaker": "",
   "page": 476,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "13",
   "text": "ふしことにちよをこめたる吳竹の末榮てもみゆる宿哉",
   "kana": "",
   "speaker": "",
   "page": 476,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "14",
   "text": "春雨も時雨もふれとむかしより色もかはらぬ宿のくれ竹",
   "kana": "",
   "speaker": "",
   "page": 476,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "15",
   "text": "さわらひのもえ出る春のゆふ暮は霞のうへに煙たちけり",
   "kana": "",
   "speaker": "",
   "page": 476,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "16",
   "text": "いつしかともえにける哉早蕨の野へはいかなる思ひなるらん",
   "kana": "",
   "speaker": "",
   "page": 476,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "17",
   "text": "ひまもなくすみれそ咲るしめのうちは庭紫にみえわたるかな",
   "kana": "",
   "speaker": "",
   "page": 476,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "18",
   "text": "日にそへて紫ふかきつほすみれふる春雨ははひにそありける",
   "kana": "",
   "speaker": "",
   "page": 476,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "19",
   "text": "君が代をのとかに匂ふいはつゝし花の盛に也にけるかな",
   "kana": "",
   "speaker": "",
   "page": 476,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "20",
   "text": "岩つゝし咲る盛は紅のいろにそみゆる春の山へは",
   "kana": "",
   "speaker": "",
   "page": 476,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "21",
   "text": "雪かとそよそにみつれと櫻花折てわきたる色のなき哉",
   "kana": "",
   "speaker": "",
   "page": 476,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "22",
   "text": "足引の山のはよりはいてねとも花こそ春のひかり也けれ",
   "kana": "",
   "speaker": "",
   "page": 476,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "23",
   "text": "春ことにみる靑柳のいとなれとかゝるなひきの枝はなかりき",
   "kana": "",
   "speaker": "",
   "page": 476,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "24",
   "text": "くりかへし過にし春も行末もかゝる柳のいとやなからむ",
   "kana": "",
   "speaker": "",
   "page": 476,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "25",
   "text": "玉ひかる糸かとみゆる靑柳になひかぬ人はあらしとそ思ふ",
   "kana": "",
   "speaker": "",
   "page": 476,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "26",
   "text": "ねぬなはの心地こそすれ汀にて柳の糸はくれとつきせす",
   "kana": "",
   "speaker": "",
   "page": 476,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  }
 ],
